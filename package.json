{
    "name": "responsive-controller",
    "version": "0.1.0",
    "scripts": {
        "dev": "concurrently -n app,preview -c blue,green \"npm:dev:app\" \"npm:dev:preview\"",
        "dev:app": "vite --config vite.app.config.js",
        "dev:preview": "vite --config vite.preview.config.js",
        "build": "vite build --config vite.app.config.js && vite build --config vite.preview.config.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/gunerbeycmp/ResponsiveController.git"
    },
    "type": "module",
    "bugs": {
        "url": "https://github.com/gunerbeycmp/ResponsiveController/issues"
    },
    "homepage": "https://github.com/gunerbeycmp/ResponsiveController#readme",
    "private": true,
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.0",
        "concurrently": "^10.0.6",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "vite": "^8.3.4",
        "vitest": "^5.0.3"
    }
}
